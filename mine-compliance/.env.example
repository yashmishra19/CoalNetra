# ── Mine Compliance FastAPI Service ─────────────────────────
# AI Provider: "ollama" (local) or "nvidia" (cloud)
AI_PROVIDER=nvidia

# Ollama (local model server) – only needed when AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# NVIDIA NIM API – only needed when AI_PROVIDER=nvidia
NVIDIA_API_KEY=your-nvidia-api-key
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-8b-instruct

# CORS: comma-separated list of allowed origins in production
# Leave unset for local dev (allows all)
ALLOWED_ORIGINS=https://your-project.vercel.app

